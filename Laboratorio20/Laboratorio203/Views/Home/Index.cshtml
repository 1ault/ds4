
@{
    Layout = null;
    @model Laboratorio203.Models.WS.ServerConfig.ServerConfig
}
<main>
    <script>
        window.AppConfig = {
            endpoint: "@Model.Endpoint"
        };
    </script>

    <script type="module" src="~/Assets/index.js"></script>

    <form name="registro">

        <div>
            <button class="button-nuevo" disabled>Nuevo</button>
            <button class="button-guardar" disabled>Guardar</button>
            <button class="button-cancelar" disabled>Cancelar</button>
            <button class="button-eliminar" disabled>Eliminar</button>

            <label for="buscar-por-id">Buscar por id</label>
            <input class="buscar-por-id" id="buscar-por-id" type="number" placeholder="10" />
            <button class="button-buscar">Buscar</button>
        </div>

        <div>
            <label for="id">id</label>
            <input class="id" id="id" type="text" disabled />

            <label for="nombre">nombre</label>
            <input class="nombre" id="nombre" type="text" disabled />
            @*<textarea class="nombre" name="nombre" id="nombre"></textarea>*@
        </div>

        <div>
            <label for="precio">precio</label>
            <input class="precio" id="precio" type="text" disabled />

            <label for="stock">stock</label>
            <input class="stock" id="stock" type="text" disabled />
            @*<textarea name="stock" id="stock"></textarea>*@
        </div>

        <div>
            <label class="label-status">Status: None</label>
        </div>

        <div>
            <button class="button-salir">Salir</button>
        </div>

    </form>
</main>